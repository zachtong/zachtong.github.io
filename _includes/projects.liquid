{% assign project = include.project | default: project %}
{% assign thumb = project.img | default: project.card_img %}
<li class="project-item{% unless thumb %} project-item--text{% endunless %}">
  {% if thumb %}
    <a class="project-item__thumb" href="{{ project.url | relative_url }}" tabindex="-1" aria-hidden="true">
      <img src="{{ thumb | relative_url }}" alt="" loading="lazy">
    </a>
  {% endif %}
  <div class="project-item__body">
    <h3 class="project-item__title">
      <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
    </h3>
    <p class="project-item__desc">{{ project.card_description | default: project.description }}</p>
    <p class="project-item__links">
      <a href="{{ project.url | relative_url }}">[Details]</a>
      {% if project.github -%}
        <a href="{{ project.github }}">[Code]</a>
      {%- endif %}
      {% if project.paper -%}
        <a href="{{ project.paper }}">[Paper]</a>
      {%- endif %}
      {% if project.pypi -%}
        <a href="{{ project.pypi }}">[PyPI]</a>
      {%- endif %}
    </p>
  </div>
</li>
