{% assign project = include.project | default: project %}
<article class="work-card {% if include.featured %}work-card--featured{% endif %}">
  <a
    class="work-card__visual{% if project.img %} work-card__visual--project-media{% endif %}"
    href="{{ project.url | relative_url }}"
    aria-label="Read about {{ project.title }}"
  >
    {% if project.img %}
      <img
        src="{{ project.img | relative_url }}"
        alt="{{ project.card_alt | default: project.title | append: ' project demonstration' }}"
        loading="lazy"
      >
    {% elsif project.card_img %}
      <img
        src="{{ project.card_img | relative_url }}"
        alt="{{ project.card_alt | default: project.title | append: ' research visualization' }}"
        loading="lazy"
      >
    {% else %}
      <span
        class="work-card__generated{% if project.visual_variant %} work-card__generated--{{ project.visual_variant }}{% endif %}"
        aria-hidden="true"
      >
        <span class="work-card__grid"></span>
        <strong>{{ project.visual_label | default: project.title }}</strong>
      </span>
    {% endif %}
    <span class="work-card__number">0{{ forloop.index }}</span>
  </a>

  <div class="work-card__body">
    <div class="work-card__meta">
      <span>{{ project.category }}</span>
      {% if project.year -%}
        <span>{{ project.year }}</span>
      {%- endif %}
    </div>
    <h3>
      <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
    </h3>
    <p>{{ project.card_description | default: project.description }}</p>
    {% if project.tags %}
      <div class="tag-list tag-list--compact">
        {% for tag in project.tags limit: 4 -%}
          <span>{{ tag }}</span>
        {%- endfor %}
      </div>
    {% endif %}
    <div class="work-card__links">
      <a class="text-link" href="{{ project.url | relative_url }}">Research detail <span aria-hidden="true">→</span></a>
      {% if project.github %}
        <a class="icon-link" href="{{ project.github }}" aria-label="{{ project.title }} on GitHub">
          <i class="fa-brands fa-github" aria-hidden="true"></i>
        </a>
      {% endif %}
    </div>
  </div>
</article>
