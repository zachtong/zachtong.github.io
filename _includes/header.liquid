<header class="site-header">
  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-md {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    aria-label="Primary navigation"
  >
    <div class="container site-nav__inner">
      <a class="site-brand" href="{{ '/' | relative_url }}" aria-label="Zixiang Tong, home">
        <span class="site-brand__mark" aria-hidden="true">ZT</span>
        <span class="site-brand__name">Zixiang Tong</span>
      </a>

      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Open navigation"
      >
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto align-items-md-center">
          {% for page in site.pages %}
            {% if page.permalink == '/' %}
              {% assign about_title = page.nav_title | default: page.title %}
            {% endif %}
          {% endfor %}

          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title -}}
              {% if page.permalink == '/' -%}
                <span class="sr-only">(current)</span>
              {%- endif %}
            </a>
          </li>

          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% assign parent_link = p.permalink | remove: 'index.html' %}
              <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                <a class="nav-link" href="{{ p.url | relative_url }}">
                  {{- p.nav_title | default: p.title -}}
                  {% if page.url contains p.url -%}
                    <span class="sr-only">(current)</span>
                  {%- endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}

          <li class="site-nav__utilities">
            {% if site.search_enabled %}
              <button id="search-toggle" class="site-icon-button" title="Search" aria-label="Search" onclick="openSearchModal()">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              </button>
            {% endif %}
            {% if site.enable_darkmode %}
              <button id="light-toggle" class="site-icon-button" title="Change color theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            {% endif %}
          </li>
        </ul>
      </div>
    </div>
  </nav>

  {% if site.enable_progressbar %}
    <progress id="progress" value="0" aria-label="Page reading progress">
      <span class="progress-container"><span class="progress-bar"></span></span>
    </progress>
  {% endif %}
</header>
