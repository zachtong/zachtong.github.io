---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign is_project = false %}
{% if page.collection == 'projects' %}
  {% assign is_project = true %}
{% endif %}

<div class="post {% if is_project %}project-detail{% endif %}">
  {% if is_project %}
    <p class="back-link"><a href="{{ '/projects/' | relative_url }}">← All projects</a></p>
  {% endif %}

  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>

    {% if is_project %}
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}

      {% if page.year or page.status or page.tags %}
        <p class="project-meta">
          {%- if page.year %}{{ page.year }}{% endif -%}
          {%- if page.status %}{% if page.year %} · {% endif %}{{ page.status }}{% endif -%}
          {%- if page.tags %}{% if page.year or page.status %} · {% endif %}{{ page.tags | join: ', ' }}{% endif -%}
        </p>
      {% endif %}

      {% if page.github or page.pypi or page.paper %}
        <p class="project-links">
          {% if page.github -%}
            <a href="{{ page.github }}">[Code]</a>
          {%- endif %}
          {% if page.pypi -%}
            <a href="{{ page.pypi }}">[PyPI]</a>
          {%- endif %}
          {% if page.paper -%}
            <a href="{{ page.paper }}">[Paper]</a>
          {%- endif %}
        </p>
      {% endif %}
    {% endif %}
  </header>

  <article class="post-content">
    {{ content }}
  </article>

  {% if page.related_publications %}
    <section class="related-publications">
      <h2>References</h2>
      <div class="publications">{% bibliography --cited_in_order %}</div>
    </section>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
