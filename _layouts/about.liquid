---
layout: default
---
{% assign socials = site.data.socials %}
<div class="home">
  <aside class="home-profile" aria-label="Profile">
    <img
      class="home-profile__photo"
      src="{{ '/assets/img/portrait.jpg' | relative_url }}"
      alt="Portrait of Zixiang Tong"
      width="1000"
      height="1000"
      fetchpriority="high"
    >
    <h1 class="home-profile__name">Zixiang (Zach) Tong</h1>
    <p class="home-profile__role">Ph.D. Candidate</p>
    <p class="home-profile__affiliation">
      <a href="https://www.ae.utexas.edu/">Department of Aerospace Engineering and Engineering Mechanics</a><br>
      <a href="https://www.utexas.edu/">The University of Texas at Austin</a>
    </p>
    <p class="home-profile__email">{{ socials.email | replace: '@', ' (at) ' }}</p>
    <nav class="home-profile__links" aria-label="Profiles">
      <a href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}" title="Google Scholar" aria-label="Google Scholar"
        ><i class="ai ai-google-scholar" aria-hidden="true"></i
      ></a>
      <a href="https://github.com/{{ socials.github_username }}" title="GitHub" aria-label="GitHub"
        ><i class="fa-brands fa-github" aria-hidden="true"></i
      ></a>
      <a href="https://www.linkedin.com/in/{{ socials.linkedin_username }}" title="LinkedIn" aria-label="LinkedIn"
        ><i class="fa-brands fa-linkedin" aria-hidden="true"></i
      ></a>
      <a href="{{ socials.cv_pdf | relative_url }}" title="CV (PDF)" aria-label="CV (PDF)"
        ><i class="fa-solid fa-file-lines" aria-hidden="true"></i
      ></a>
    </nav>
  </aside>

  <div class="home__main">
    {{ content }}

    {% if page.announcements and page.announcements.enabled %}
      <section class="home__news" aria-labelledby="news-title">
        <h2 id="news-title">News</h2>
        {% include news.liquid limit=true %}
        <p class="home__more"><a href="{{ '/news/' | relative_url }}">All news</a></p>
      </section>
    {% endif %}
  </div>
</div>
